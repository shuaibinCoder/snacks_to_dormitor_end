<configuration>
  <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
    <encoder><pattern>%level %logger{36} - %msg%n</pattern></encoder>
  </appender>
  <logger name="com.tencent.wxcloudrun.config.SnacksExceptionHandler" level="OFF"/>
  <root level="WARN"><appender-ref ref="CONSOLE"/></root>
</configuration>
