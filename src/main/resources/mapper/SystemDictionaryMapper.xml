<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.tencent.wxcloudrun.dao.SystemDictionaryMapper">
  <resultMap id="dictionaryMap" type="com.tencent.wxcloudrun.model.SystemDictionary">
    <id property="id" column="_id"/><result property="type" column="type"/>
    <result property="name" column="name"/><result property="description" column="description"/>
    <result property="items" column="items" typeHandler="com.tencent.wxcloudrun.dao.DataListTypeHandler"/>
    <result property="version" column="version"/><result property="createdAt" column="createdAt"/>
    <result property="updatedAt" column="updatedAt"/>
  </resultMap>
  <sql id="columns">`_id`, `type`, `name`, `description`, `items`, `version`, `createdAt`, `updatedAt`</sql>
  <select id="selectAll" resultMap="dictionaryMap">
    SELECT <include refid="columns"/> FROM `system_dictionaries` ORDER BY `_id`
  </select>
  <insert id="insertIgnore" parameterType="com.tencent.wxcloudrun.model.SystemDictionary">
    INSERT INTO `system_dictionaries` (<include refid="columns"/>)
    VALUES (#{id},#{type},#{name},#{description},#{items,typeHandler=com.tencent.wxcloudrun.dao.DataListTypeHandler},#{version},#{createdAt},#{updatedAt})
    ON DUPLICATE KEY UPDATE `_id`=`_id`
  </insert>
  <update id="update" parameterType="com.tencent.wxcloudrun.model.SystemDictionary">
    UPDATE `system_dictionaries` SET `type`=#{type},`name`=#{name},`description`=#{description},
      `items`=#{items,typeHandler=com.tencent.wxcloudrun.dao.DataListTypeHandler},`version`=#{version},`updatedAt`=#{updatedAt}
    WHERE `_id`=#{id}
  </update>
</mapper>
